{
  "name": "scantling",
  "private": true,
  "version": "0.1.0",
  "license": "PolyForm-Strict-1.0.0",
  "type": "module",
  "workspaces": ["packages/*", "apps/*", "tools/*", "website"],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test",
    "audit": "bun tools/audit-deps.ts",
    "check": "bun run typecheck && bun run audit && bun run test",
    "hooks": "git config core.hooksPath .githooks",
    "lint:commits": "bun tools/lint-commit.ts --range origin/master..HEAD",
    "hardware": "bun packages/hardware/src/cli.ts",
    "config": "bun packages/config/src/cli.ts",
    "docs": "bun run --filter @scantling/website dev",
    "docs:build": "bun run --filter @scantling/website build",
    "dev": "bun run --filter @scantling/web dev",
    "build": "bun run --filter @scantling/web build",
    "start": "bun run --filter @scantling/web start",
    "train": "bun packages/runner/src/train.ts",
    "train:overfit": "bun packages/training/src/overfit.ts",
    "train:scaling": "bun packages/training/src/scaling.ts",
    "bench": "bun tools/bench/src/cli.ts",
    "bench:inference": "bun packages/inference/src/bench.ts",
		"tokenizer": "bun packages/tokenizer/src/cli.ts",
    "dataset": "bun packages/datasets/src/cli.ts",
    "checkpoint": "bun packages/checkpoint/src/cli.ts",
		"generate": "bun packages/inference/src/cli.ts",
		"profile": "bun packages/training/src/profile.ts",
		"evaluate": "bun packages/runner/src/evaluate.ts",
		"corpus": "bun packages/datasets/src/licensed.ts",
    "release": "bun tools/release.ts"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "typescript": "7.0.2"
  }
}
